<Project Sdk="Microsoft.NET.Sdk">
  <!-- Blue's Archery Overhaul for Quest (IL2CPP): the same source files as the PC mod, compiled with QUEST defined.
       dotnet build BluesArcheryOverhaul.Quest -c Release -p:QuestReferences=C:\ATTUnity\QuestRefs\ATT-Quest-Modding-dlls\questdlls -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BluesArcheryOverhaul.Quest</AssemblyName>
    <RootNamespace>BluesArcheryOverhaul</RootNamespace>
    <DefineConstants>$(DefineConstants);QUEST</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The interop's proxy types carry no nullable annotations, so every game value reads as "maybe null" (the PC build checks
         the same lines with real annotations); CS0649, CS0169, CS0414, CS0162: fields and code only the server's patches, left out here, use. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8604;CS8605;CS8634;CS0649;CS0169;CS0414;CS0162</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Every source file of the PC mod, compiled with QUEST defined (docs/superpowers/plans/2026-11-22-quest-port.md). Left out:
         the file only a dedicated server runs (SkyfallCommands.cs). -->
    <Compile Include="..\BluesArcheryOverhaul\*.cs" Exclude="..\BluesArcheryOverhaul\SkyfallCommands.cs" />
    <EmbeddedResource Include="..\BluesArcheryOverhaul\Resources\**\*" Exclude="..\BluesArcheryOverhaul\Resources\**\*.manifest;..\BluesArcheryOverhaul\Resources\**\*.meta" LogicalName="BluesArcheryOverhaul.Resources.%(Filename)%(Extension)" />
    <Reference Include="$(QuestReferences)\*.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckQuestReferences" BeforeTargets="ResolveReferences" Condition="!Exists('$(QuestReferences)\MelonLoader.dll')">
    <Error Text="Pass -p:QuestReferences=&lt;folder with the Quest game's Il2Cpp assemblies, MelonLoader.dll and Il2CppInterop.Runtime.dll&gt;" />
  </Target>
</Project>
